# ---- MongoDB ----
# API ini jalan di VPS yang sama dengan MongoDB, jadi pakai localhost (tanpa hop network).
MONGODB_URI=mongodb://127.0.0.1:27017/namadatabase

# Ukuran connection pool. Naikkan kalau request bersamaan banyak.
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2

# ---- Server ----
PORT=3333
NODE_ENV=production

# Kalau di belakang nginx, biarkan 1 supaya req.ip benar (bukan IP nginx).
TRUST_PROXY=1

# ---- Auth ----
# WAJIB diisi. Jangan pakai nilai yang pernah ke-commit ke git.
API_KEY=ganti-dengan-key-baru-yang-panjang-dan-acak

# WAJIB diisi terpisah dari API_KEY (jangan dibiarkan kosong).
# Generate: openssl rand -base64 48
JWT_SECRET=ganti-dengan-secret-acak-48-karakter

JWT_EXPIRES_IN=10y

# ---- Optimasi ----
# Cache hasil cek token di memory (ms) supaya tidak query MongoDB tiap request.
# Efek samping: logout/revoke baru terasa setelah TTL ini lewat. 0 = matikan cache.
TOKEN_CACHE_TTL_MS=60000
TOKEN_CACHE_MAX=5000

# Batas body request. Naikkan kalau upload list_akun besar.
BODY_LIMIT=100mb

# Batas maksimum limit pagination yang boleh diminta client.
MAX_PAGE_LIMIT=100

# CORS: '*' untuk semua origin, atau daftar dipisah koma.
# Contoh: CORS_ORIGIN=https://panel.domain.com,https://admin.domain.com
CORS_ORIGIN=*

# ---- Dokumentasi ----
# Halaman Swagger di /docs. Bawaannya MATI.
# Halaman ini memaparkan seluruh peta endpoint ke siapa pun yang membukanya,
# jadi kalau API ini terbuka ke internet, nyalakan seperlunya saja atau
# batasi aksesnya lewat nginx (lihat README).
ENABLE_SWAGGER=false
SWAGGER_PATH=/docs
